<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stock-dashboard.local</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/Realtek_NVME/stock_dashboard/runtime/scripts/serve_foreground.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Volumes/Realtek_NVME/stock_dashboard/runtime</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Volumes/Realtek_NVME/stock_dashboard/runtime/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/Realtek_NVME/stock_dashboard/runtime/logs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
